# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sólo en el servidor. Las escrituras sobre las rondas pasan por acá, porque son
# las que aplican las reglas del juego. Nunca exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Código que hay que saber para entrar a la liga.
CODIGO_INVITACION=

# Mail del recordatorio de las 17:00 (Resend). Opcional para desarrollo.
RESEND_API_KEY=
MAIL_DESDE="¿A qué hora arranca? <arranca@tudominio.ar>"

# Protege el endpoint que dispara el recordatorio.
CRON_SECRET=
